# Copia este archivo a .env y ajusta los valores si hace falta.
# Valores locales ficticios; no usar en ningún entorno compartido.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/app_db
