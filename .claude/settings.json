{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run python -c *)",
      "Bash(uv run alembic *)",
      "Bash(uv run uvicorn *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit -m *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)"
    ]
  }
}
